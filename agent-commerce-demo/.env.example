# OrderCore agent-commerce demo — configuration.
# Copy to .env and fill in, OR just export these in your shell.
# Leave ORDERCORE_API_KEY empty to run offline in mock mode (no signup needed).

# Live key from https://ordercore.ai/bootstrap (3-day trial). Empty = mock mode.
ORDERCORE_API_KEY=

# API base URL. Default is the hosted API; override for self-hosted/staging.
ORDERCORE_BASE_URL=https://api.ordercore.ai

# A real SKU UUID from your catalog (live mode only). The demo has a placeholder default.
ORDERCORE_SKU_ID=
